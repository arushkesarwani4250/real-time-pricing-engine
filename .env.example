# Upstream WebSocket Feed Configuration
UPSTREAM_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# Downstream Server Configuration
PORT=8080
LOG_LEVEL=info

# Set to true to run in local simulation mode (simulating 61 live currency pairs)
MOCK_FEED=false

# Allowed WebSocket origins (comma-separated, or * for development)
ALLOWED_ORIGINS=*
